rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /poems/{poemId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner() {
        return isSignedIn() && resource.data.userId == request.auth.uid;
      }

      allow read: if true;
      allow create: if isSignedIn()
          && request.resource.data.userId == request.auth.uid;
      allow update: if isOwner();
      allow delete: if isOwner();
    }

    match /favorites/{favoriteId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner() {
        return isSignedIn() && resource.data.userId == request.auth.uid;
      }

      allow read: if true;
      allow create: if isSignedIn()
          && favoriteId == request.auth.uid + "_" + request.resource.data.poemId
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.poemId is string;
      allow update: if false;
      allow delete: if isOwner();
    }

    match /comments/{commentId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner() {
        return isSignedIn() && resource.data.userId == request.auth.uid;
      }

      allow read: if true;
      allow create: if isSignedIn()
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.poemId is string
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 600;
      allow update: if false;
      allow delete: if isOwner();
    }

    match /readingProgress/{progressId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function ownsProgress() {
        return isSignedIn() && request.resource.data.userId == request.auth.uid;
      }

      function ownsExistingProgress() {
        return isSignedIn() && resource.data.userId == request.auth.uid;
      }

      allow read: if ownsExistingProgress();
      allow create: if ownsProgress()
          && progressId == request.auth.uid + "_" + request.resource.data.poemId
          && request.resource.data.poemId is string
          && request.resource.data.progress is number
          && request.resource.data.progress >= 0
          && request.resource.data.progress <= 100;
      allow update: if ownsExistingProgress()
          && ownsProgress()
          && progressId == request.auth.uid + "_" + request.resource.data.poemId
          && request.resource.data.progress is number
          && request.resource.data.progress >= 0
          && request.resource.data.progress <= 100;
      allow delete: if ownsExistingProgress();
    }
  }
}
